# Copy to .dev.vars for local development (never commit .dev.vars).

# Google OAuth client (Web application). Authorized redirect URI: http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: "Continue with email" sign-in through WorkOS AuthKit (use the Staging environment's values).
# Redirect URI to add in WorkOS: http://localhost:5173/auth/workos/callback
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Optional: "Continue with Microsoft" sign-in through your organization's Entra ID tenant (see the README).
# Redirect URI to add to the app registration: http://localhost:5173/auth/microsoft/callback
# MS_TENANT_ID is the tenant's ID (a GUID) or one of its domains, never "common".
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# Optional: notifications (Web Push). Make a pair for local use with:  npm run -s push-keys >> .dev.vars
# (Deployed instances get their own automatically on the first `npm run deploy`.)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional, comma-separated: addresses always let in as admins. (On an empty database the first person to sign in
# becomes the admin anyway.)
ADMIN_EMAILS=

# Local only: enables /auth/dev-login?email=... so you can sign in as seeded users without Google.
# Ignored unless the request comes from localhost. Never set this in production.
DEV_LOGIN=1
